{
  "compilerOptions": {
    "composite": true,
    "target": "es2018",
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "baseUrl": ".",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "fomu": ["packages/fomu/*"],
      "fomu/types": ["packages/fomu/src/types/index"],
      "fomu/types/*": ["packages/fomu/src/types/*"],
      "fomu/shape": ["packages/fomu/src/shape/index"],
      "fomu/shape/*": ["packages/fomu/src/shape/*"],
      "fomu/graph": ["packages/fomu/src/graph/index"],
      "fomu/graph/*": ["packages/fomu/src/graph/*"],
      "fomu/renderer": ["packages/fomu/src/renderer/index"],
      "fomu/renderer/*": ["packages/fomu/src/renderer/*"],
      "@fomu/components/*": ["packages/components/*"],
      "@fomu/common/*": ["packages/common/*"],
      "@fomu/utils/*": ["packages/utils/*"]
    },
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node",
      "element-plus/global"
    ],
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "removeComments": false,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": [
    "types",
    "packages",
    "playground"
  ],
  "exclude": [
    "unocss.config.ts",
    "node_modules",
    "**/*.md",
    "**/dist"
  ]
}
